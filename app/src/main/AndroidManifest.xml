<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read-only: this app never sends, edits, or deletes SMS. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only used to hand voice input in Dhanpal Chat off to the system speech
         recognizer via an implicit intent — audio never leaves the device
         through this app's own code. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Opt-in (Settings > Bhai Call, off by default): lets the budget-exceeded
         alert launch as a full-screen incoming-call-style screen instead of a
         normal notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- No CAMERA permission needed: receipt scanning hands off to the
         device's own camera app via an implicit intent and only receives
         back the photo it took, never touching the camera hardware directly. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".DhanapalaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dhanapala"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dhanapala">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Standalone incoming-call-style screen for The Bhai Call, launched via a
             full-screen notification intent. singleInstance + excludeFromRecents so
             it behaves like a real call screen, not a regular app window. -->
        <activity
            android:name=".ui.call.BhaiCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Dhanapala" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Catches bank/UPI SMS the instant they arrive so spend/credit alerts
             don't wait for the user to open the app. exported=true is required
             for the system to deliver SMS_RECEIVED; only the platform (holding
             BROADCAST_SMS) can send that broadcast. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.DhanpalWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dhanpal_widget_info" />
        </receiver>
    </application>

</manifest>
